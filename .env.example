# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to .env and configure local settings.
# WARNING: DO NOT commit your production .env file to version control!
# ==============================================================================

# Project Name
COMPOSE_PROJECT_NAME=haproxy_load_balancer

# HAProxy Configuration
HAPROXY_STATS_PORT=8404

# Grafana Configuration
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin_secret_change_me

# Prometheus Configuration
PROMETHEUS_PORT=9090

# Nginx Backends Node Ports (if you want to expose them directly for debugging)
# Normally they are isolated inside backend-net and not accessible directly from host.
NGINX_EXPOSE_PORT_1=8081
NGINX_EXPOSE_PORT_2=8082
NGINX_EXPOSE_PORT_3=8083

# Network Subnets (Use unique non-overlapping ranges)
FRONTEND_SUBNET=172.28.0.0/16
BACKEND_SUBNET=172.29.0.0/16
